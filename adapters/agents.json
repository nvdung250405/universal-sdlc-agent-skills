{
  "schema_version": 1,
  "note": "These are configurable conventional paths, not guarantees of permanent vendor behavior. Use --dest when the local installation differs.",
  "agents": {
    "claude": {
      "project": ".claude/skills",
      "global": "~/.claude/skills",
      "docs": "https://docs.anthropic.com/en/docs/claude-code/skills"
    },
    "codex": {
      "project": ".agents/skills",
      "global": "~/.agents/skills",
      "docs": "https://developers.openai.com/codex/skills"
    },
    "gemini": {
      "project": ".gemini/skills",
      "global": "~/.gemini/skills",
      "docs": "https://github.com/google-gemini/gemini-cli"
    },
    "cursor": {
      "project": ".cursor/skills",
      "global": "~/.cursor/skills",
      "docs": "https://docs.cursor.com/context/skills"
    },
    "copilot": {
      "project": ".github/skills",
      "global": "~/.copilot/skills",
      "docs": "https://docs.github.com/en/copilot"
    },
    "antigravity": {
      "project": ".agents/skills",
      "global": "~/.gemini/config/skills",
      "docs": "https://antigravity.google/docs/skills?app=antigravity-ide",
      "notes": "Antigravity IDE. Workspace path is .agents/skills; global path is ~/.gemini/config/skills."
    },
    "antigravity-cli": {
      "project": ".agents/skills",
      "global": "~/.gemini/antigravity-cli/skills",
      "docs": "https://antigravity.google/docs/skills?app=antigravity",
      "notes": "Antigravity CLI. Workspace path is .agents/skills; global path is ~/.gemini/antigravity-cli/skills."
    }
  }
}
